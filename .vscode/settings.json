{
  "task.allowAutomaticTasks": "on",

  // ── Error Lens: show errors inline ──
  "errorLens.enabled": true,
  "errorLens.messageEnabled": true,
  "errorLens.messageTemplate": "$message",
  "errorLens.fontSize": "12px",
  "errorLens.fontWeight": "500",
  "errorLens.padding": "2px 6px",
  "errorLens.margin": "0 0 0 8px",
  "errorLens.borderRadius": "4px",

  // ── ESLint: only check standalone .js files ──
  "eslint.enable": true,
  "eslint.validate": ["javascript"],

  // ── HTML + inline JS validation ──
  "html.validate.scripts": true,
  "html.validate.styles": true,
  "javascript.validate.enable": true,

  // ── File exclusions ──
  "files.watcherExclude": {
    "**/backups/**": true,
    "**/tmp/**": true,
    "**/hugging-voice/**/worklets/**": true
  },
  "search.exclude": {
    "**/backups": true,
    "**/tmp": true,
    "**/.venv": true
  },

  // ── Formatting ──
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "files.insertFinalNewline": true
}
