{
  "$comment": [
    "SINGLE SOURCE OF TRUTH for the sottotitoli.pro grid, type scale and palette.",
    "brand/build_tokens.py turns this into brand/tokens.css (for the page) and into",
    "the pixel constants the video renderer uses. Nothing may hard-code a grid",
    "number anywhere else — that duplication is what drifts silently.",
    "Units in the 'frame' space are pixels of a 1920x1080 canvas; the builder also",
    "emits each one as a percentage so CSS and video agree at any scale."
  ],
  "frame": { "w": 1920, "h": 1080 },

  "grid": {
    "margin": 34,
    "header_h": 89,
    "gutter": 21,
    "phi": 1.618033988749895,
    "side_ratio": 0.382,
    "logo_w": 300,
    "tabs": 4,
    "tab_w": 144,
    "tab_pad": 14
  },

  "type": {
    "display": 64,
    "h1": 44,
    "h2": 26,
    "lede": 20,
    "body": 17,
    "small": 14,
    "micro": 12,
    "lh_tight": 1.08,
    "lh_body": 1.62,
    "tracking_display": 0.01,
    "tracking_caps": 0.28,
    "tracking_caps_wide": 0.36
  },

  "font": {
    "display": "'Space Grotesk', 'Manrope', ui-sans-serif, sans-serif",
    "ui": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "display_weight": 500,
    "body_weight": 400
  },

  "colour": {
    "bg": "#05070d",
    "surface": "#0a1018",
    "ink": "#e9f0ff",
    "dim": "#93a2c4",
    "faint": "#6e7d9e",
    "accent": "#7fd0ff",
    "warm": "#ffe7bc",
    "ok": "#8ef0c8",
    "line": "rgba(128, 168, 235, 0.30)"
  },

  "contrast_gate": {
    "$comment": "WCAG 2.1 AA. Body pairs must reach ratio; large-text pairs only need 3.0.",
    "required": [
      ["ink", "bg", 4.5],
      ["ink", "surface", 4.5],
      ["dim", "bg", 4.5],
      ["accent", "bg", 4.5],
      ["bg", "accent", 4.5]
    ],
    "large_only": [
      ["faint", "bg", 3.0]
    ]
  }
}
