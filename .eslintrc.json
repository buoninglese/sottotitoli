{
  "env": {
    "browser": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-extra-semi": "error",
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty": "warn",
    "no-irregular-whitespace": "warn",
    "no-unexpected-multiline": "error"
  },
  "ignorePatterns": [
    "hugging-voice/**",
    "hugging-voice-base/**",
    "hugging-voice-kokoro/**",
    "css/**",
    "webfonts/**",
    "fonts/**",
    "img/**",
    "backups/**",
    "supabase/**",
    "mockups/**",
    "tmp/**",
    "tools/**"
  ]
}
