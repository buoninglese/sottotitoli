<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flow Insights Mockup</title>
  <style>
    :root{
      --bg: #f6f2ee;
      --shell: #f7f4f0;
      --panel: #ffffff;
      --line: #ece5dc;
      --line-2: #e8e0d6;
      --text: #171717;
      --muted: #7f766d;
      --muted-2: #9b9187;
      --teal: #1f6b69;
      --teal-2: #3f9994;
      --teal-3: #83d0ce;
      --teal-4: #d2efef;
      --beige: #d8d0c2;
      --active: #ece4da;
      --purple: #eecff8;
      --purple-soft: #f7ecff;
      --purple-border: #efddfb;
      --shadow: 0 0 0 1px rgba(0,0,0,.03), 0 12px 24px rgba(0,0,0,.04);
      --radius-xl: 28px;
      --radius-lg: 18px;
      --radius-md: 14px;
      --radius-sm: 12px;
      --sidebar: 258px;
      --topbar: 64px;
      --icon: 21px;
      --font: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body{
      margin:0;
      background: var(--bg);
      font-family: var(--font);
      color: var(--text);
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .window{
      width:min(1871px, 100vw);
      height:min(1080px, 100vh);
      background: var(--shell);
      border-radius: 24px;
      overflow:hidden;
      box-shadow: inset 0 0 0 1px rgba(27,81,108,.15);
      border-top: 2px solid #2a698d;
      position:relative;
    }

    .topbar{
      height: var(--topbar);
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding: 0 22px;
      background: var(--shell);
    }

    .topbar-left, .topbar-right{
      display:flex;
      align-items:center;
      gap:18px;
    }

    .traffic{
      display:flex;
      gap:10px;
      align-items:center;
    }

    .dot{
      width:15px;
      height:15px;
      border-radius:50%;
      display:inline-block;
    }

    .red{ background:#ff5f57; }
    .yellow{ background:#febc2e; }
    .green{ background:#28c840; }

    .split{
      width:24px;
      height:18px;
      border:2px solid #575757;
      border-radius:3px;
      position:relative;
      opacity:.85;
      margin-left:8px;
    }

    .split:before{
      content:"";
      position:absolute;
      left:7px;
      top:-2px;
      bottom:-2px;
      width:2px;
      background:#575757;
    }

    .shell{
      display:flex;
      height:calc(100% - var(--topbar));
    }

    aside{
      width:var(--sidebar);
      padding:14px 14px 18px 14px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .logo-row{
      display:flex;
      align-items:center;
      gap:12px;
      padding:10px 10px 18px 10px;
    }

    .logo{
      display:flex;
      align-items:center;
      gap:8px;
      font-size:22px;
      font-weight:700;
      letter-spacing:-.02em;
    }

    .logo-bars{
      display:flex;
      align-items:flex-end;
      gap:3px;
      height:24px;
    }

    .logo-bars span{
      width:4px;
      background:#212121;
      border-radius:8px;
      display:block;
    }

    .logo-bars span:nth-child(1){ height:13px; }
    .logo-bars span:nth-child(2){ height:22px; }
    .logo-bars span:nth-child(3){ height:16px; }
    .logo-bars span:nth-child(4){ height:10px; }
    .logo-bars span:nth-child(5){ height:20px; }

    .pill{
      background: var(--purple);
      color:#262126;
      font-weight:600;
      font-size:14px;
      padding:8px 11px;
      line-height:1;
      border-radius:12px;
    }

    .nav{
      display:flex;
      flex-direction:column;
      gap:4px;
      margin-top:4px;
    }

    .nav-item{
      display:flex;
      align-items:center;
      gap:12px;
      padding:12px 14px;
      border-radius:12px;
      color:#1d1d1d;
      font-size:18px;
      line-height:1.2;
    }

    .nav-item.active{
      background: var(--active);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,.02);
    }

    .nav-item svg, .lower-links svg, .topbar-right svg, .usage-row svg, .device-row svg{
      width:var(--icon);
      height:var(--icon);
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex: 0 0 auto;
    }

    .promo{
      margin:18px 0 16px 0;
      background: var(--purple-soft);
      border:1px solid var(--purple-border);
      border-radius:16px;
      padding:18px 18px 20px 18px;
      color:#2b2430;
    }

    .promo h4{
      margin:0 0 10px 0;
      font-size:18px;
      font-weight:500;
    }

    .promo h4 span{
      color:#6e40a9;
      font-weight:700;
    }

    .promo p{
      margin:0 0 16px 0;
      font-size:14px;
      line-height:1.7;
      color:#5f5862;
    }

    .promo .btn-dark{
      display:inline-block;
      background:#191919;
      color:#fff;
      border-radius:12px;
      padding:12px 22px;
      font-weight:600;
      font-size:16px;
      text-decoration:none;
    }

    .lower-links{
      display:flex;
      flex-direction:column;
      gap:6px;
      margin-top:auto;
    }

    .lower-links .nav-item{
      padding:10px 14px;
    }

    main{
      flex:1;
      padding:10px 14px 14px 0;
    }

    .panel{
      height:100%;
      background:var(--panel);
      border-radius:34px;
      box-shadow: var(--shadow);
      padding:46px 40px 38px 40px;
      position:relative;
      overflow:hidden;
    }

    .content{
      max-width: 1336px;
      margin: 0 auto;
      position:relative;
    }

    .page-title{
      font-size:26px;
      font-weight:700;
      margin:0 0 34px 0;
      letter-spacing:-.02em;
    }

    .share-badge{
      position:absolute;
      top:-2px;
      right:4px;
      width:96px;
      height:96px;
      display:grid;
      place-items:center;
    }

    .tabs{
      display:flex;
      gap:30px;
      align-items:flex-end;
      border-bottom:1px solid #ece7df;
      margin-bottom:60px;
    }

    .tab{
      font-size:18px;
      font-weight:600;
      color:#454545;
      padding:10px 0 16px 0;
      position:relative;
    }

    .tab.active{
      color:#171717;
    }

    .tab.active::after{
      content:"";
      position:absolute;
      left:0;
      right:0;
      bottom:0;
      height:3px;
      border-radius:3px;
      background:#202020;
    }

    .stats-grid{
      display:grid;
      grid-template-columns: 1fr 1fr 2fr;
      gap:28px;
      margin-bottom:30px;
    }

    .card{
      background:#fffdfa;
      border:1px solid #efe9e0;
      border-radius:14px;
      min-height:236px;
      padding:22px 22px 18px 22px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
    }

    .stat-number{
      font-size:50px;
      font-weight:500;
      line-height:1;
      margin-bottom:8px;
      letter-spacing:-.03em;
    }

    .label{
      font-size:15px;
      color:#5f5851;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .label-row{
      display:flex;
      align-items:center;
      gap:8px;
    }

    .info-dot{
      width:20px;
      height:20px;
      border:1.5px solid #bdb4aa;
      border-radius:50%;
      display:grid;
      place-items:center;
      color:#a1958b;
      font-size:12px;
      transform: translateY(1px);
    }

    .gauge-wrap{
      margin-top:16px;
      display:flex;
      justify-content:center;
    }

    .mini-stat{
      min-height:236px;
    }

    .dictated{
      display:flex;
      flex-direction:column;
    }

    .divider{
      margin:20px 0 16px 0;
      height:1px;
      background:#d9d1c8;
    }

    .device-row{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:16px;
      margin-top:auto;
    }

    .device-meta{
      display:flex;
      gap:10px;
      align-items:flex-start;
      font-size:21px;
      font-weight:500;
    }

    .device-meta small{
      display:block;
      font-size:18px;
      font-weight:400;
      margin-top:2px;
    }

    .btn-lite{
      border:1px solid #ebe5de;
      background:#fff;
      border-radius:14px;
      padding:14px 18px;
      font-size:18px;
      font-weight:600;
      color:#262626;
      box-shadow: 0 1px 0 rgba(0,0,0,.02);
    }

    .bottom-grid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:30px;
    }

    .big-card{
      background:#fffdfa;
      border:1px solid #efe9e0;
      border-radius:14px;
      min-height:435px;
      padding:22px 22px 20px 22px;
    }

    .card-head{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:20px;
      margin-bottom:24px;
    }

    .big-title{
      font-size:34px;
      line-height:1.05;
      letter-spacing:-.03em;
      font-weight:600;
      margin:0;
    }

    .caps{
      text-transform:uppercase;
      font-size:14px;
      color:#2e2b28;
      letter-spacing:.14em;
      font-weight:600;
      white-space:nowrap;
      padding-top:16px;
    }

    .usage-list{
      display:flex;
      flex-direction:column;
      gap:18px;
      margin-top:6px;
    }

    .usage-row{
      display:grid;
      grid-template-columns: 28px 1fr auto;
      align-items:center;
      gap:14px;
    }

    .bar{
      height:36px;
      background:#e7eceb;
      border-radius:4px;
      position:relative;
      overflow:hidden;
      min-width: 330px;
    }

    .bar > span{
      position:absolute;
      inset:0 auto 0 0;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#fff;
      font-size:15px;
      font-weight:700;
      letter-spacing:.08em;
      background:var(--teal);
      border-radius:4px;
    }

    .tiny-bar{
      width:66px;
      height:34px;
      border-radius:6px;
      background: #6fc6c1;
      color:#fff;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:700;
      font-size:14px;
      letter-spacing:.06em;
      flex:0 0 auto;
    }

    .usage-right{
      font-size:17px;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:#24211f;
      font-weight:500;
      white-space:nowrap;
    }

    .usage-row.compact{
      grid-template-columns: 28px 66px auto;
    }

    .usage-row.compact.zero .tiny-bar{
      background:#69c8c2;
    }

    .streak-top{
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-bottom:10px;
    }

    .months{
      display:grid;
      grid-template-columns: 20px repeat(4, 1fr) 20px;
      align-items:center;
      color:#8d857b;
      margin:2px 0 20px 0;
      font-size:18px;
    }

    .months .arrow{
      font-size:34px;
      color:#d0c9bf;
      user-select:none;
      line-height:1;
    }

    .months .m{
      text-align:center;
    }

    .heatmap{
      display:grid;
      grid-template-columns: 30px repeat(20, 22px);
      gap:9px 10px;
      align-items:center;
      margin-top:10px;
    }

    .day{
      font-size:15px;
      color:#7e756c;
    }

    .sq{
      width:22px;
      height:22px;
      border-radius:3px;
      background:#f7f5f2;
      border:1px solid #f2eeea;
    }

    .sq.l1{ background:#d7f1f1; border-color:#d7f1f1; }
    .sq.l2{ background:#b6e4e3; border-color:#b6e4e3; }
    .sq.l3{ background:#56a8a4; border-color:#56a8a4; }
    .sq.l4{ background:#2e7f7b; border-color:#2e7f7b; }
    .sq.beige{ background:#cec7bd; border-color:#cec7bd; }

    .legend{
      display:flex;
      align-items:center;
      gap:10px;
      margin-top:28px;
      color:#7d756c;
      font-size:16px;
    }

    .legend .sw{
      width:21px;
      height:21px;
      border-radius:3px;
      display:inline-block;
    }

    .scroll-thumb{
      position:absolute;
      left:50%;
      bottom:12px;
      transform:translateX(-50%);
      width:48px;
      height:10px;
      background:#8f8c87;
      border-radius:999px;
      box-shadow: inset 0 1px 2px rgba(255,255,255,.35);
    }

    @media (max-width: 1400px){
      .stats-grid{ grid-template-columns: 1fr; }
      .bottom-grid{ grid-template-columns: 1fr; }
      aside{ width:220px; }
      .bar{ min-width: 220px; }
    }
  </style>
</head>
<body>
  <div class="window">
    <div class="topbar">
      <div class="topbar-left">
        <div class="traffic">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="split" aria-hidden="true"></div>
      </div>

      <div class="topbar-right">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18H5.5a1.5 1.5 0 0 1-1.2-2.4L6 13.5V10a6 6 0 1 1 12 0v3.5l1.7 2.1A1.5 1.5 0 0 1 18.5 18H15"></path>
          <path d="M10 20a2 2 0 0 0 4 0"></path>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="4"></circle>
          <path d="M4.5 19a8.5 8.5 0 0 1 15 0"></path>
        </svg>
      </div>
    </div>

    <div class="shell">
      <aside>
        <div>
          <div class="logo-row">
            <div class="logo">
              <div class="logo-bars" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
              <span>Flow</span>
            </div>
            <div class="pill">Pro Trial</div>
          </div>

          <nav class="nav">
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1"></rect><rect x="14" y="4" width="6" height="6" rx="1"></rect><rect x="4" y="14" width="6" height="6" rx="1"></rect><rect x="14" y="14" width="6" height="6" rx="1"></rect></svg>
              <span>Home</span>
            </div>
            <div class="nav-item active">
              <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M8 16V9"></path><path d="M12 16V6"></path><path d="M16 16v-4"></path></svg>
              <span>Insights</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><path d="M7 4h8l4 4v11a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path><path d="M15 4v5h5"></path><circle cx="10" cy="13" r="2.5"></circle><path d="M10 10.5v5"></path></svg>
              <span>Dictionary</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><path d="M7 7l10 10"></path><path d="M14 4l6 6"></path><path d="M4 14l6 6"></path><path d="M6 4l3 3-5 5a2 2 0 0 0 0 3l2 2a2 2 0 0 0 3 0l5-5 3 3"></path></svg>
              <span>Snippets</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><path d="M4 7h16"></path><path d="M9 7v10"></path><path d="M15 7v10"></path><path d="M4 17h8"></path><path d="M14 17h6"></path></svg>
              <span>Style</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><path d="M4 20l7-7"></path><path d="M14 10l6-6"></path><path d="M8 4l3 3"></path><path d="M16 12l4 4"></path><path d="M3 17l4 4"></path><path d="M11 5l8 8"></path></svg>
              <span>Transforms</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><path d="M5 4h14a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-4 4V5a1 1 0 0 1 1-1z"></path><path d="M8 8h8"></path><path d="M8 12h5"></path></svg>
              <span>Scratchpad</span>
            </div>
          </nav>
        </div>

        <div>
          <div class="promo">
            <h4>Trial ends in <span>14 days</span></h4>
            <p>Upgrade to Flow Pro to keep unlimited words and Pro features.</p>
            <a href="#" class="btn-dark">Upgrade to Pro</a>
          </div>

          <div class="lower-links">
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><circle cx="8" cy="11" r="3"></circle><circle cx="16" cy="9" r="2.5"></circle><path d="M3.5 18a5 5 0 0 1 9 0"></path><path d="M13 17a4 4 0 0 1 7 0"></path></svg>
              <span>Invite your team</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><rect x="5" y="7" width="14" height="13" rx="2"></rect><path d="M12 3v8"></path><path d="M8 11h8"></path></svg>
              <span>Get a free month</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5"></circle><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.3.8a7.4 7.4 0 0 0-1.8-1L14.5 3h-5L9.2 5.9a7.4 7.4 0 0 0-1.8 1l-2.3-.8-2 3.4 2 1.5a7 7 0 0 0 0 2l-2 1.5 2 3.4 2.3-.8a7.4 7.4 0 0 0 1.8 1l.3 2.9h5l.3-2.9a7.4 7.4 0 0 0 1.8-1l2.3.8 2-3.4-2-1.5c.1-.3.1-.6.1-1z"></path>
              </svg>
              <span>Settings</span>
            </div>
            <div class="nav-item">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M9.2 9a3 3 0 1 1 5.5 1.7c-.8 1-1.7 1.5-1.7 2.8"></path><path d="M12 17h.01"></path></svg>
              <span>Help</span>
            </div>
          </div>
        </div>
      </aside>

      <main>
        <div class="panel">
          <div class="content">
            <div class="share-badge" aria-hidden="true">
              <svg viewBox="0 0 120 120" width="96" height="96">
                <defs>
                  <path id="circlePath" d="M60,60 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"></path>
                </defs>
                <text fill="#236d69" font-size="13" font-family="Inter, sans-serif" letter-spacing="4" font-weight="700">
                  <textPath href="#circlePath" startOffset="0%">SHARE • SHARE • SHARE • </textPath>
                </text>
                <circle cx="60" cy="60" r="28" fill="white"></circle>
                <path d="M60 74V44M60 44l-8 8M60 44l8 8" stroke="#111" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M49 60v15h22V60" stroke="#111" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>

            <h1 class="page-title">Insights</h1>

            <div class="tabs">
              <div class="tab active">Your Usage</div>
              <div class="tab">Your Voice</div>
            </div>

            <section class="stats-grid">
              <div class="card">
                <div class="stat-number">70</div>
                <div class="label-row">
                  <div class="label">Words per minute</div>
                  <div class="info-dot">i</div>
                </div>

                <div class="gauge-wrap">
                  <svg width="270" height="135" viewBox="0 0 270 135" aria-hidden="true">
                    <path d="M40 110 A95 95 0 0 1 230 110"
                          fill="none"
                          stroke="#d4cec3"
                          stroke-width="22"
                          stroke-linecap="round"
                          pathLength="100"></path>
                    <path d="M40 110 A95 95 0 0 1 230 110"
                          fill="none"
                          stroke="#1f6b69"
                          stroke-width="22"
                          stroke-linecap="round"
                          pathLength="100"
                          stroke-dasharray="82 100"></path>
                    <text x="135" y="68" text-anchor="middle" fill="#6d655d" font-size="23" font-family="Inter, sans-serif">Top</text>
                    <text x="135" y="105" text-anchor="middle" fill="#181818" font-size="28" font-weight="700" font-family="Inter, sans-serif">16%</text>
                  </svg>
                </div>
              </div>

              <div class="card mini-stat">
                <div class="stat-number">0</div>
                <div class="label">Fixes made by Flow</div>
              </div>

              <div class="card dictated">
                <div class="stat-number">25</div>
                <div class="label">Total words dictated</div>
                <div class="divider"></div>
                <div class="device-row">
                  <div class="device-meta">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 20h8"></path><path d="M12 17v3"></path></svg>
                    <div>Desktop<small>25 words</small></div>
                  </div>
                  <button class="btn-lite">Download on mobile</button>
                </div>
              </div>
            </section>

            <section class="bottom-grid">
              <div class="big-card">
